{
  "schema_version": 1,
  "appearance": "Restrained realistic black M7 material sample",
  "color_space": "linear RGB",
  "coordinate_space": "source_assembly_world_metres",
  "axes": "+X muzzle, +Z up",
  "parameter_semantics": {
    "base_color": "Three linear RGB values; alpha is 1 for these opaque roles.",
    "roughness_variation": "Symmetric amplitude about the role roughness; clamp to 0.02 through 0.98.",
    "finegrain_scale_per_m": "Spatial frequency in cycles per metre, evaluated in source world space before atlas baking.",
    "grain_strength": "Dimensionless multiplier for the finegrain normal or bump contribution.",
    "grain_height_m": "Maximum finegrain relief in metres; does not modify silhouette geometry.",
    "wear_amount": "Small baseline fraction for coating loss, only inside explicit contact masks and convex edges. Zero disables baseline loss.",
    "object_role_overrides": "Apply in list order. Last matching object_regex wins for slots matching only_source_materials; preserve all other slots.",
    "wear_masks": "Suggestions for localized baking. A regex selects source objects; ellipsoid coordinates are not catalog or display-scene coordinates. Effect finish_polish changes color and roughness only. Effect coating_loss can blend toward exposed_steel.",
    "mirror_y": "Also evaluate the same mask with center_m[1] negated; combine mirrored values using max, not sum."
  },
  "global_settings": {
    "use_existing_large_grain_textures": false,
    "grain_sampling_policy": "Filter or attenuate subpixel grain during baking; never enlarge its world-space size to make it visible.",
    "base_color_noise_amplitude": 0.003,
    "base_color_noise_scale_per_m": 120.0,
    "wear_combine": "max",
    "coating_loss_requires_convex_edge": true,
    "coating_loss_sparse_noise_threshold": 0.95,
    "coating_loss_speck_scale_per_m": 1400.0,
    "coating_loss_max_visible_area_fraction": 0.006,
    "coating_loss_max_blend": 0.34,
    "no_global_edge_outline": true,
    "no_dirt_in_open_apertures": true,
    "preserve_materials": [
      "M7R_08_Glass",
      "M7R_09_CoatedLens"
    ],
    "notes": "Keep the black coating dielectric. Small bare hardware carries metal reflections; edge exposure is sparse, narrow and dark gray. Convex-edge masks must exclude recess rims that cannot be contacted."
  },
