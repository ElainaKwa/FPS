# ==============================================================
#  MCP_Test — Unreal Engine 5.8
#  原则：只忽略“可由引擎/工具重新生成”的内容。
#        源码、配置、美术源文件、文档一律纳入版本控制。
# ==============================================================

# ---------- 引擎构建产物（可完全重新生成） ----------
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
Plugins/*/Binaries/
Plugins/*/Intermediate/
Plugins/*/DerivedDataCache/
Plugins/*/Saved/

# 打包产物
*.pak
*.ucas
*.utoc
*.sig

# ---------- IDE / 编辑器本地状态 ----------
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.opendb
*.opensdf
*.sdf

# 由引擎或 IDE 生成的工程文件
*.sln
*.slnx
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.csproj
*.csproj.user
*.props
*.targets
*.xcodeproj
*.xcworkspace

# VS Code：仅保留需要共享的配置
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# ---------- 编译中间文件 ----------
*.o
*.obj
*.pch
*.gch
*.lo
*.slo
*.a
*.lib
*.la
*.lai
*.so
*.dylib
*.dll
*.exe
*.out
*.app
*.ipa
*.mod
*.pdb
*.idb
*.ilk
*.exp
*.res
*.rsp

# ---------- Python 缓存 ----------
__pycache__/
*.py[cod]

# ---------- 操作系统文件 ----------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
